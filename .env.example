# Mock is the default, even if an API key is present.
LLM_PROVIDER=mock
OPENAI_API_KEY=
# Required only for openai mode. Choose a Responses-compatible model available to your account.
OPENAI_MODEL=
LLM_TIMEOUT_MS=30000
MAX_OUTPUT_TOKENS=512
# Optional; blank disables persistence. Use a dedicated educational database.
MONGODB_URI=
PORT=3000
# Set 0.0.0.0 only behind appropriate access controls for cloud hosting.
HOST=127.0.0.1
